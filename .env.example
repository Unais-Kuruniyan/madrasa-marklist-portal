# ---------------------------------------------------------------
# Copy this file to `.env` (local dev) and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# NEVER commit your real `.env` file.
# ---------------------------------------------------------------

# --- Public (exposed to the browser bundle; safe by design) ---
# Supabase Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase anon / publishable key (NOT the service_role / secret key!)
VITE_SUPABASE_ANON_KEY=

# --- Server-only (used by the Vercel cron function in /api; never exposed) ---
# Random secret string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional: server-side copies for the keep-alive function.
# If omitted, the function falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# DO NOT add SUPABASE_SERVICE_ROLE_KEY here. This app does not need it.
